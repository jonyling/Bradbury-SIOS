# Copy to .env. Git ignores .env. Do not paste values into chat.
#
# Bradbury SIOS Phase 0: news / STE / Dataverse / FIRMS keys below are LEGACY
# (quarantined). Active SIOS work uses synthetic fixtures under data/synthetic/.

# Optional: override synthetic fixture directory (tests).
# SIOS_SYNTHETIC_DIR=

# Optional: local DB path for the legacy signal pool / future SIOS store.
# GRIT_DB=output/grit.sqlite

# --- Quarantined legacy GRIT-Scan credentials (not required for Phase 0) ---

# Gemini on Vertex / express mode (legacy agents / future Co-Pilot).
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Search APIs — quarantined (news acquisition not an SIOS path).
# BRAVE_SEARCH_API_KEY=
# BRAVE_MONTHLY_LIMIT=2000
# CURRENTS_API_KEY=
# GDELT_DAILY_MAX=8

# DeepSeek — quarantined reasoned weekly path.
# DEEPSEEK_API_KEY=

# NASA FIRMS — quarantined URS Taiwan lane.
# FIRMS_MAP_KEY=

# Microsoft Graph / RED mail — quarantined.
# GRAPH_TENANT_ID=
